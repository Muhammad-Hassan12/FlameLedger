# Local paths are relative to the repository root unless absolute.
FLAMELEDGER_RUN_DIR=NASA_Flame_In_Freefall_Final/runs/full
FLAMELEDGER_RELEASE_DIR=build/release
FLAMELEDGER_RUNTIME_MODE=cached_bm25
FLAMELEDGER_DATA_MODE=verified
FLAMELEDGER_HOST=127.0.0.1
FLAMELEDGER_PORT=8000
FLAMELEDGER_TORCH_THREADS=2
FLAMELEDGER_ENCODE_TIMEOUT_SECONDS=3
FLAMELEDGER_CACHE_DIR=build/cache
# Fill these only on the server. Empty key selects the evidence-only briefing.
GEMINI_API_KEY=
# Set a model available to your API key; no model is silently substituted.
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_REQUESTS_PER_MINUTE=10
# Deployment handoff (optional locally; never read by the browser).
VPS_HOST=
VPS_SSH_USER=
VPS_SSH_KEY_PATH=
FLAMELEDGER_PUBLIC_HOSTNAME=
ACME_EMAIL=

