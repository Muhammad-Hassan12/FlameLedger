FLAMELEDGER_RELEASE_DIR=/opt/flameledger/current
# Use cached_bm25 until live CPU/RAM measurements pass on this host.
FLAMELEDGER_RUNTIME_MODE=cached_bm25
FLAMELEDGER_DATA_MODE=verified
FLAMELEDGER_TORCH_THREADS=2
FLAMELEDGER_ENCODE_TIMEOUT_SECONDS=3
FLAMELEDGER_CACHE_DIR=/var/cache/flameledger
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=8
GEMINI_MAX_OUTPUT_TOKENS=1000
GEMINI_REQUESTS_PER_MINUTE=10
