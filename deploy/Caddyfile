{
    email {$ACME_EMAIL}
}

{$FLAMELEDGER_PUBLIC_HOSTNAME} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy strict-origin-when-cross-origin
        Content-Security-Policy "default-src 'self'; img-src 'self'; style-src 'self'; script-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    handle /api/* {
        request_body {
            max_size 20KB
        }
        reverse_proxy 127.0.0.1:8000
    }
    handle {
        root * /opt/flameledger/current/frontend
        @versioned path /assets/*
        header @versioned Cache-Control "public, max-age=31536000, immutable"
        @entry path / /index.html
        header @entry Cache-Control "no-cache"
        file_server
    }
}
